# Comma-separated, case-insensitive text fragments. "database" also matches "databases".
TOPICS=database

# Public live-tail endpoint. No login or API key is needed for live collection.
JETSTREAM_SERVICE=https://jetstream.us-east.bsky.network

# Local persistence.
DATABASE_PATH=./data/posts.sqlite

# Optional: enables historical replay (`npm run collect -- --replay`).
# Create a key at https://bsky.network/account
JETSTREAM_API_KEY=

# Optional test/smoke-test limits. Zero means unlimited.
MAX_EVENTS=0
MAX_MATCHES=0
